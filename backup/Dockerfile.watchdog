FROM postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873
RUN apk add --no-cache python3 ca-certificates && mkdir -p /app && chown postgres:postgres /app
WORKDIR /app
COPY --chown=postgres:postgres backup/ ./backup/
COPY --chown=postgres:postgres test/backup/live-watchdog.py ./test/backup/live-watchdog.py
USER postgres
ENV CLIENT_BACKUP_MONITOR_ENABLED=false CLIENT_BACKUP_ALERTS_ENABLED=false \
    CLIENT_BACKUP_LIVE_WATCHDOG_TEST=false
ENTRYPOINT ["python3", "/app/backup/watchdog.py"]
